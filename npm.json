{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "peerDependencies",
        "packageManager",
        "pnpm"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies",
        "pnpm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm Dependencies",
      "automerge": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm Development Dependencies",
      "automerge": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm Peer Dependencies",
      "automerge": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Corepack packageManager",
      "automerge": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "pnpm"
      ],
      "matchSourceUrls": [
        "https://github.com/DefinitelyTyped/DefinitelyTyped"
      ],
      "groupName": "DefinitelyTyped npm Dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "pnpm"
      ],
      "matchSourceUrls": [
        "https://github.com/sveltejs/*"
      ],
      "groupName": "Svelte npm Dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "pnpm"
      ],
      "matchSourceUrls": [
        "https://github.com/withastro/*"
      ],
      "groupName": "Astro npm Dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "pnpm"
      ],
      "matchSourceUrls": [
        "https://github.com/vitejs/*"
      ],
      "groupName": "Vite npm Dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "pnpm"
      ],
      "matchSourceUrls": [
        "https://github.com/vitest-dev/*"
      ],
      "groupName": "Vitest npm Dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepNames": [
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
