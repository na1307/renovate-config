{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "gradle"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "test",
        "plugin"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Gradle Dependencies",
      "automerge": true
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Gradle Development Dependencies",
      "automerge": true
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchDepTypes": [
        "test"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Gradle Test Dependencies",
      "automerge": true
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchDepTypes": [
        "plugin"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Gradle Plugins",
      "automerge": true
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchDepTypes": [
        "plugin"
      ],
      "matchDepNames": [
        "com.android.application",
        "com.android.library"
      ],
      "enabled": false
    }
  ]
}
