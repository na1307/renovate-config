{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Cargo Dependencies",
      "automerge": true
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchSourceUrls": [
        "https://github.com/serde-rs/*"
      ],
      "groupName": "serde-rs Cargo Dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchSourceUrls": [
        "https://github.com/microsoft/windows-rs"
      ],
      "groupName": "windows-rs Cargo Dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
