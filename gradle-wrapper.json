{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Gradle Wrapper",
      "automerge": true
    },
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
