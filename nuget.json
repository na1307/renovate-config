{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "nuget",
        "msbuild-sdk",
        "dotnet-sdk"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "nuget",
        "msbuild-sdk"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "NuGet Dependencies",
      "automerge": true
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "nuget"
      ],
      "matchDepNames": [
        "Microsoft.*",
        "System.*"
      ],
      "groupName": "Microsoft NuGet Dependencies"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "nuget"
      ],
      "matchDepNames": [
        "CommunityToolkit.*"
      ],
      "groupName": "Community Toolkit NuGet Dependencies"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "nuget"
      ],
      "matchDepNames": [
        "Avalonia",
        "Avalonia.*"
      ],
      "groupName": "Avalonia NuGet Dependencies"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "nuget"
      ],
      "matchDepNames": [
        "Spectre.Console",
        "Spectre.Console.*"
      ],
      "groupName": "Spectre.Console NuGet Dependencies"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "nuget"
      ],
      "matchDepNames": [
        "Roslynator.*"
      ],
      "groupName": "Roslynator NuGet Dependencies"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "nuget"
      ],
      "matchDepNames": [
        "Bluehill.*"
      ],
      "groupName": "Bluehill NuGet Dependencies"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "dotnet-sdk"
      ],
      "groupName": ".NET SDK",
      "automerge": false
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepTypes": [
        "dotnet-sdk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
